# .env.example → .env qilib nusxalang va to‘ldiring

# Ariza formasi menejerlar chatiga shu bot orqali keladi (@BotFather orqali bot yarating)
TELEGRAM_BOT_TOKEN=
# Arizalar keladigan chat/guruh ID (masalan, -1001234567890)
TELEGRAM_CHAT_ID=

# Arizani saytning o‘z /api/lead funksiyasi o‘rniga backendga yuborish (ixtiyoriy).
# Masalan: https://<backend-staging-domeni>/leads/rutim — shunda TELEGRAM_* kerak emas.
VITE_LEAD_ENDPOINT=

# Saytda ko‘rsatiladigan telefon (ixtiyoriy). Masalan: +998 90 123 45 67
VITE_PHONE=
# Instagram/Facebook reklamasi uchun Meta Pixel ID (ixtiyoriy):
# PageView — ochilganda, InitiateCheckout — paket tanlanganda, Lead — ariza yuborilganda
PIXEL_ID=
