# .env.example → .env qilib nusxalang va to‘ldiring

# Ariza formasi menejerlar chatiga shu bot orqali keladi (@BotFather orqali bot yarating)
TELEGRAM_BOT_TOKEN=
# Arizalar keladigan chat/guruh ID (masalan, -1001234567890)
TELEGRAM_CHAT_ID=

# Saytda ko‘rsatiladigan telefon (ixtiyoriy). Masalan: +998 90 123 45 67
VITE_PHONE=
# Instagram/Facebook reklamasi uchun Meta Pixel ID (ixtiyoriy) — ariza yuborilganda "Lead" hodisasi
VITE_META_PIXEL_ID=
