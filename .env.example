# .env.example → .env qilib nusxalang va to‘ldiring

# Saytdagi "Telegram’da yozish" tugmalari shu username’ga ochiladi (@ belgisisiz)
VITE_TELEGRAM_USERNAME=rutim_b2b
# Saytda ko‘rsatiladigan telefon (ixtiyoriy)
